# Copy to .streamlit/secrets.toml (git-ignored) for local runs, and paste the
# same keys into the Streamlit Community Cloud "Secrets" panel on deploy.

# Shared app password (login gate).
APP_PASSWORD = "change-me"

# Supabase — project URL + SERVICE_ROLE key (server-side only; never exposed to
# the browser because Streamlit runs server-side).
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
SUPABASE_KEY = "YOUR-SERVICE-ROLE-KEY"

# Earth Engine.
GEE_PROJECT = "utomika"

# RECOMMENDED: put the service-account key as a TOML *table*, one field per key.
# This avoids the "Invalid control character" JSONDecodeError you get when a
# whole JSON blob is pasted and the private_key's line breaks aren't escaped.
#
# IMPORTANT: keep the private_key on ONE line, with the newlines written as the
# two characters \n (backslash-n), exactly as they appear in the downloaded JSON
# file. Do NOT paste a multi-line PEM here.
[gee_service_account]
type = "service_account"
project_id = "utomika"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...single line...==\n-----END PRIVATE KEY-----\n"
client_email = "ee-labeler@utomika.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "..."

# (Alternative: a single JSON string under GEE_SERVICE_ACCOUNT_JSON also works,
#  but is easy to get wrong — the table above is safer.)
#
# Locally you may instead omit the service account entirely and rely on your own
# `earthengine authenticate` session — init_ee() falls back to it.
